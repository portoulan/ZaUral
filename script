// ======================================================
// НАСТРОЙКИ
// ======================================================

const MIGRATIONS_FILE = "data/migrations.csv";
const REGIONS_FILE = "data/regions.geojson";
const NODES_FILE = "data/nodes.csv";
const EDGES_FILE = "data/edges.csv";


// ======================================================
// КАРТА
// ======================================================

const map = L.map("map", {
    zoomControl: true
}).setView([55, 60], 4);


L.tileLayer(
    "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
    {
        attribution: "&copy; OpenStreetMap contributors"
    }
).addTo(map);


// ======================================================
// СЛОИ
// ======================================================

let regionsLayer = null;
let flowLayer = L.layerGroup().addTo(map);
let nodesLayer = L.layerGroup().addTo(map);


// ======================================================
// ДАННЫЕ
// ======================================================

let migrations = [];
let regions = {};
let nodes = {};
let edges = [];

let years = [];


// ======================================================
// ЗАГРУЗКА ДАННЫХ
// ======================================================

Promise.all([
    loadCSV(MIGRATIONS_FILE),
    loadGeoJSON(REGIONS_FILE),
    loadCSV(NODES_FILE),
    loadCSV(EDGES_FILE)
])
.then(([migrationData, geojson, nodeData, edgeData]) => {

    migrations = migrationData;

    prepareRegions(geojson);

    prepareNodes(nodeData);

    prepareEdges(edgeData);

    prepareMigrations();

    createYearSelector();

    drawRegions();

    drawNodes();

    drawFlows();

})
.catch(error => {

    console.error(error);

    alert(
        "Ошибка загрузки данных. Проверь названия файлов и структуру CSV."
    );

});


// ======================================================
// ЗАГРУЗКА CSV
// ======================================================

function loadCSV(file) {

    return new Promise((resolve, reject) => {

        Papa.parse(file, {

            download: true,

            header: true,

            skipEmptyLines: true,

            complete: results => {

                resolve(results.data);

            },

            error: error => {

                reject(error);

            }

        });

    });

}


// ======================================================
// ЗАГРУЗКА GEOJSON
// ======================================================

function loadGeoJSON(file) {

    return fetch(file)
        .then(response => {

            if (!response.ok) {
                throw new Error(
                    "Не удалось загрузить " + file
                );
            }

            return response.json();

        });

}


// ======================================================
// РЕГИОНЫ
// ======================================================

function prepareRegions(geojson) {

    geojson.features.forEach(feature => {

        const id = feature.properties.id;

        regions[id] = feature;

    });

}


// ======================================================
// УЗЛЫ
// ======================================================

function prepareNodes(data) {

    data.forEach(row => {

        const id = String(row.id || row.node_id).trim();

        nodes[id] = {

            id: id,

            name: row.name || id,

            lat: parseFloat(row.lat),

            lon: parseFloat(row.lon)

        };

    });

}


// ======================================================
// СВЯЗИ МЕЖДУ УЗЛАМИ
// ======================================================

function prepareEdges(data) {

    edges = data.map(row => {

        return {

            from: String(row.from).trim(),

            to: String(row.to).trim()

        };

    });

}


// ======================================================
// ПОДГОТОВКА МИГРАЦИЙ
// ======================================================

function prepareMigrations() {

    migrations.forEach(row => {

        row.migrants = Number(
            String(row.migrants || 0)
                .replace(/\s/g, "")
                .replace(",", ".")
        );

        row.year = String(row.year).trim();

        row.origin = String(row.origin).trim();

        row.destination =
            String(row.destination).trim();

    });

    years = [...new Set(
        migrations
            .map(row => row.year)
            .filter(Boolean)
    )].sort();

}


// ======================================================
// СПИСОК ГОДОВ
// ======================================================

function createYearSelector() {

    const select =
        document.getElementById("yearSelect");

    years.forEach(year => {

        const option =
            document.createElement("option");

        option.value = year;

        option.textContent = year;

        select.appendChild(option);

    });

}


// ======================================================
// ОТРИСОВКА РЕГИОНОВ
// ======================================================

function drawRegions() {

    regionsLayer = L.geoJSON(
        Object.values(regions),
        {

            style: {

                color: "#555",

                weight: 1,

                fillColor: "#eee",

                fillOpacity: 0.35

            },

            onEachFeature: function(feature, layer) {

                const name =
                    feature.properties.name ||
                    feature.properties.NAME ||
                    feature.properties.id;

                layer.bindTooltip(name);

                layer.on("click", function() {

                    showRegionInfo(
                        feature.properties.id,
                        name
                    );

                });

            }

        }
    ).addTo(map);

}


// ======================================================
// УЗЛЫ
// ======================================================

function drawNodes() {

    nodesLayer.clearLayers();

    if (
        !document.getElementById("showNodes").checked
    ) {
        return;
    }

    Object.values(nodes).forEach(node => {

        L.circleMarker(
            [node.lat, node.lon],
            {

                radius: 6,

                color: "#222",

                weight: 2,

                fillColor: "#fff",

                fillOpacity: 1

            }
        )

        .bindTooltip(node.name)

        .addTo(nodesLayer);

    });

}


// ======================================================
// ПОИСК КООРДИНАТЫ РЕГИОНА
// ======================================================

function getRegionPoint(id) {

    const feature = regions[id];

    if (!feature) {

        console.warn(
            "Не найден регион:",
            id
        );

        return null;

    }

    const layer =
        L.geoJSON(feature);

    return layer.getBounds().getCenter();

}


// ======================================================
// КООРДИНАТЫ ЛЮБОЙ ТОЧКИ ГРАФА
// ======================================================

function getPoint(id) {

    // Если это узел

    if (nodes[id]) {

        return [
            nodes[id].lat,
            nodes[id].lon
        ];

    }


    // Если это регион

    const point =
        getRegionPoint(id);

    if (point) {

        return [
            point.lat,
            point.lng
        ];

    }

    return null;

}


// ======================================================
// ПОИСК МАРШРУТА ПО ГРАФУ
// ======================================================

function findRoute(start, end) {

    const queue = [
        [start]
    ];

    const visited =
        new Set([start]);


    while (queue.length > 0) {

        const path =
            queue.shift();

        const current =
            path[path.length - 1];


        if (current === end) {

            return path;

        }


        const nextNodes =
            edges

                .filter(edge =>
                    edge.from === current
                )

                .map(edge =>
                    edge.to
                );


        nextNodes.forEach(next => {

            if (!visited.has(next)) {

                visited.add(next);

                queue.push([
                    ...path,
                    next
                ]);

            }

        });

    }

    return null;

}


// ======================================================
// ПОСТРОЕНИЕ ПОТОКОВ
// ======================================================

function drawFlows() {

    flowLayer.clearLayers();


    const selectedYear =
        document.getElementById("yearSelect").value;


    const minFlow =
        Number(
            document.getElementById("minFlow").value
        );


    let filtered =
        migrations.filter(row => {

            if (
                selectedYear !== "all" &&
                row.year !== selectedYear
            ) {
                return false;
            }

            return row.migrants >= minFlow;

        });


    filtered.forEach(migration => {

        const route =
            findRoute(
                migration.origin,
                migration.destination
            );


        if (!route) {

            console.warn(
                "Маршрут не найден:",
                migration.origin,
                "→",
                migration.destination
            );

            return;

        }


        for (
            let i = 0;
            i < route.length - 1;
            i++
        ) {

            const from =
                getPoint(route[i]);

            const to =
                getPoint(route[i + 1]);


            if (!from || !to) {
                continue;
            }


            const width =
                getFlowWidth(
                    migration.migrants
                );


            const line =
                L.polyline(
                    [from, to],
                    {

                        color: "#c62828",

                        weight: width,

                        opacity: 0.65,

                        lineCap: "round",

                        lineJoin: "round"

                    }
                );


            line.bindTooltip(

                `<b>${migration.origin}</b>
                → 
                <b>${migration.destination}</b>
                <br>
                ${formatNumber(
                    migration.migrants
                )} переселенцев`

            );


            line.on("click", function() {

                showFlowInfo(migration);

            });


            line.addTo(flowLayer);

        }

    });

}


// ======================================================
// ТОЛЩИНА ПОТОКА
// ======================================================

function getFlowWidth(value) {

    // логарифмическое масштабирование

    const width =
        2 +
        Math.log10(
            Math.max(value, 1)
        ) * 3;

    return Math.min(
        width,
        25
    );

}


// ======================================================
// ИНФОРМАЦИЯ О ПОТОКЕ
// ======================================================

function showFlowInfo(row) {

    document.getElementById("info").innerHTML = `

        <strong>
            ${row.origin}
            →
            ${row.destination}
        </strong>

        <br><br>

        Год:
        ${row.year}

        <br>

        Переселенцев:
        <strong>
            ${formatNumber(row.migrants)}
        </strong>

    `;

}


// ======================================================
// ИНФОРМАЦИЯ О РЕГИОНЕ
// ======================================================

function showRegionInfo(id, name) {

    const selectedYear =
        document.getElementById("yearSelect").value;


    let data =
        migrations.filter(row => {

            if (
                selectedYear !== "all" &&
                row.year !== selectedYear
            ) {
                return false;
            }

            return (
                row.origin === id ||
                row.destination === id
            );

        });


    const total =
        data.reduce(
            (sum, row) =>
                sum + row.migrants,
            0
        );


    document.getElementById("info").innerHTML = `

        <strong>${name}</strong>

        <br><br>

        Потоков:
        ${data.length}

        <br>

        Всего:
        <strong>
            ${formatNumber(total)}
        </strong>

    `;

}


// ======================================================
// ФОРМАТ ЧИСЕЛ
// ======================================================

function formatNumber(number) {

    return Number(number)
        .toLocaleString("ru-RU");

}


// ======================================================
// UI
// ======================================================

document
    .getElementById("yearSelect")
    .addEventListener(
        "change",
        drawFlows
    );


document
    .getElementById("minFlow")
    .addEventListener(
        "input",
        function() {

            document
                .getElementById("minFlowValue")
                .textContent =
                this.value;

            drawFlows();

        }
    );


document
    .getElementById("showNodes")
    .addEventListener(
        "change",
        drawNodes
    );


document
    .getElementById("showRegions")
    .addEventListener(
        "change",
        function() {

            if (
                this.checked
            ) {

                regionsLayer.addTo(map);

            } else {

                map.removeLayer(
                    regionsLayer
                );

            }

        }
    );
