// =====================================================
// ФАЙЛЫ
// =====================================================

const MIGRATIONS_FILE = "data/migration.csv";
const NODES_FILE = "data/NODES.csv";
const EDGES_FILE = "data/EDGES.csv";


// =====================================================
// КАРТА
// =====================================================

const map = L.map("map").setView([52, 70], 4);

L.tileLayer(
    "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
    {
        attribution: "&copy; OpenStreetMap contributors"
    }
).addTo(map);


// =====================================================
// СЛОИ
// =====================================================

const flowLayer = L.layerGroup().addTo(map);
const nodesLayer = L.layerGroup().addTo(map);


// =====================================================
// ДАННЫЕ
// =====================================================

let migrations = [];
let nodes = {};
let routes = [];


// =====================================================
// ЗАГРУЗКА
// =====================================================

Promise.all([
    loadCSV(MIGRATIONS_FILE),
    loadCSV(NODES_FILE),
    loadCSV(EDGES_FILE)
])
.then(([migrationData, nodeData, edgeData]) => {

    console.log("MIGRATIONS:", migrationData);
    console.log("NODES:", nodeData);
    console.log("EDGES:", edgeData);

    prepareMigrations(migrationData);

    prepareNodes(nodeData);

    prepareRoutes(edgeData);

    drawNodes();

    drawFlows();

})
.catch(error => {

    console.error(error);

    alert(
        "Ошибка загрузки данных. Открой консоль браузера (F12)."
    );

});


// =====================================================
// CSV
// =====================================================

function loadCSV(file) {

    return new Promise((resolve, reject) => {

        Papa.parse(file, {

            download: true,

            header: true,

            delimiter: ";",

            skipEmptyLines: true,

            complete: function(results) {

                resolve(results.data);

            },

            error: function(error) {

                reject(error);

            }

        });

    });

}


// =====================================================
// МИГРАЦИИ
// =====================================================

function prepareMigrations(data) {

    migrations = data
        .map(row => {

            const origin =
                String(
                    row.Origin || ""
                )
                .replace(/^\uFEFF/, "")
                .trim();


            const number =
                Number(
                    String(
                        row.Number || "0"
                    )
                    .replace(/\s/g, "")
                    .replace(",", ".")
                );


            return {

                origin: origin,

                number: number

            };

        })
        .filter(row =>
            row.origin &&
            row.number > 0
        );


    console.log(
        "Подготовленные миграции:",
        migrations
    );

}


// =====================================================
// УЗЛЫ
// =====================================================

function prepareNodes(data) {

    data.forEach(row => {

        const id =
            String(
                row.id || ""
            )
            .replace(/^\uFEFF/, "")
            .trim();


        if (!id) {
            return;
        }


        // Убираем возможную запятую после координаты

        const lat =
            parseFloat(
                String(row.lat || "")
                .replace(",", ".")
            );


        const lon =
            parseFloat(
                String(row.lon || "")
                .replace(",", ".")
            );


        if (
            Number.isNaN(lat) ||
            Number.isNaN(lon)
        ) {

            console.warn(
                "Некорректные координаты:",
                row
            );

            return;

        }


        nodes[id] = {

            id: id,

            lat: lat,

            lon: lon

        };

    });


    console.log(
        "Узлы:",
        nodes
    );

}


// =====================================================
// МАРШРУТЫ
// =====================================================
//
// Каждая строка EDGES.csv — это цепочка:
//
// N1;N2;N3;N4;Тургайская
//
// превращается в:
//
// N1 → N2
// N2 → N3
// N3 → N4
// N4 → Тургайская
//
// =====================================================

function prepareRoutes(data) {

    routes = [];


    data.forEach(row => {

        const values =
            Object.values(row)
            .map(value =>
                String(value || "").trim()
            )
            .filter(value =>
                value !== ""
            );


        if (values.length < 2) {
            return;
        }


        // Убираем возможный BOM

        values[0] =
            values[0]
            .replace(/^\uFEFF/, "");


        // Создаем последовательность

        for (
            let i = 0;
            i < values.length - 1;
            i++
        ) {

            const from = values[i];

            const to = values[i + 1];


            routes.push({

                from: from,

                to: to,

                migrants: 0

            });

        }

    });


    console.log(
        "Ребер:",
        routes.length
    );

    console.log(
        "Маршруты:",
        routes
    );

}


// =====================================================
// КООРДИНАТЫ УЗЛА
// =====================================================

function getNodePoint(id) {

    if (!nodes[id]) {

        return null;

    }


    return [
        nodes[id].lat,
        nodes[id].lon
    ];

}


// =====================================================
// ПОИСК ВСЕХ ПОТОКОВ ОТ ГУБЕРНИИ
// =====================================================
//
// Здесь используется обход графа.
//
// Например:
//
// Архангельская
//      ↓
//     N1
//      ↓
//     N2
//      ↓
//     N3
//      ↓
// Тургайская
//
// =====================================================

function findPathsFromOrigin(origin) {

    const startingEdges =
        routes.filter(
            edge =>
                edge.from === origin
        );


    const paths = [];


    startingEdges.forEach(edge => {

        walkPath(
            edge.to,
            [origin, edge.to],
            paths,
            new Set([origin])
        );

    });


    return paths;

}


// =====================================================
// ОБХОД ГРАФА
// =====================================================

function walkPath(
    current,
    path,
    paths,
    visited
) {

    // Если дошли до конечного региона,
    // который не является узлом

    if (!nodes[current]) {

        paths.push(path);

        return;

    }


    // Защита от циклов

    if (visited.has(current)) {

        return;

    }


    visited.add(current);


    const nextEdges =
        routes.filter(
            edge =>
                edge.from === current
        );


    // Если продолжения нет

    if (nextEdges.length === 0) {

        paths.push(path);

        return;

    }


    nextEdges.forEach(edge => {

        walkPath(
            edge.to,
            [
                ...path,
                edge.to
            ],
            paths,
            new Set(visited)
        );

    });

}


// =====================================================
// АГРЕГАЦИЯ ПОТОКОВ
// =====================================================
//
// Здесь происходит самое важное.
//
// Если:
//
// Архангельская = 33
// Астраханская = 524
//
// идут:
//
// Архангельская → N1
// Астраханская → N1
//
// а затем:
//
// N1 → N2
//
// то:
//
// N1 → N2 = 557
//
// =====================================================

function calculateFlows() {

    const segmentFlows = {};


    migrations.forEach(migration => {

        const paths =
            findPathsFromOrigin(
                migration.origin
            );


        if (paths.length === 0) {

            console.warn(
                "Не найден маршрут:",
                migration.origin
            );

            return;

        }


        paths.forEach(path => {

            for (
                let i = 0;
                i < path.length - 1;
                i++
            ) {

                const from = path[i];

                const to = path[i + 1];


                const key =
                    from + "||" + to;


                if (
                    !segmentFlows[key]
                ) {

                    segmentFlows[key] = {

                        from: from,

                        to: to,

                        value: 0,

                        origins: []

                    };

                }


                segmentFlows[key].value +=
                    migration.number;


                segmentFlows[key].origins.push(
                    migration.origin
                );

            }

        });

    });


    return Object.values(
        segmentFlows
    );

}


// =====================================================
// ОТРИСОВКА УЗЛОВ
// =====================================================

function drawNodes() {

    nodesLayer.clearLayers();


    Object.values(nodes).forEach(node => {

        L.circleMarker(
            [
                node.lat,
                node.lon
            ],
            {

                radius: 4,

                color: "#333",

                weight: 1,

                fillColor: "#fff",

                fillOpacity: 1

            }
        )
        .bindTooltip(
            node.id
        )
        .addTo(nodesLayer);

    });

}


// =====================================================
// ТОЛЩИНА
// =====================================================

function getFlowWidth(value) {

    // Логарифмическое масштабирование

    const width =
        1.5 +
        Math.log10(
            Math.max(value, 1)
        ) * 3;


    return Math.min(
        width,
        25
    );

}


// =====================================================
// ОТРИСОВКА ПОТОКОВ
// =====================================================

function drawFlows() {

    flowLayer.clearLayers();


    const flows =
        calculateFlows();


    console.log(
        "Итоговые потоки:",
        flows
    );


    flows.forEach(flow => {

        const fromPoint =
            getNodePoint(
                flow.from
            );


        const toPoint =
            getNodePoint(
                flow.to
            );


        // Если это конечный регион,
        // пока у нас нет его координат.
        //
        // Поэтому такой сегмент пропускаем.

        if (
            !fromPoint ||
            !toPoint
        ) {

            return;

        }


        const line =
            L.polyline(
                [
                    fromPoint,
                    toPoint
                ],
                {

                    color: "#c62828",

                    weight:
                        getFlowWidth(
                            flow.value
                        ),

                    opacity: 0.65,

                    lineCap: "round",

                    lineJoin: "round"

                }
            );


        line.bindTooltip(

            `
            <b>
                ${flow.from}
                → 
                ${flow.to}
            </b>
            <br>
            ${formatNumber(flow.value)}
            переселенцев
            `

        );


        line.addTo(
            flowLayer
        );

    });

}


// =====================================================
// ФОРМАТ ЧИСЛА
// =====================================================

function formatNumber(number) {

    return Number(number)
        .toLocaleString(
            "ru-RU"
        );

}
